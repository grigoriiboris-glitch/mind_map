package repository

import (
	"context"
	"fmt"
	"reflect"
	"strings"
	"time"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"
	"{{ .Module }}/models"
)

type {{ .Name }}Repository struct {
	pool      *pgxpool.Pool
	fields    []string
	tableName string
}

func New{{ .Name }}Repository(pool *pgxpool.Pool) *{{ .Name }}Repository {
	tableName := "{{ .Name | lower }}s"
	
	repo := &{{ .Name }}Repository{
		pool:      pool,
		tableName: tableName,
	}
	
	// Инициализируем поля сразу
	repo.initFields()
	
	return repo
}

func (r *{{ .Name }}Repository) initFields() {
	if len(r.fields) > 0 {
		return
	}

	modelType := reflect.TypeOf(models.{{ .Name }}{})
	for i := 0; i < modelType.NumField(); i++ {
		field := modelType.Field(i)
		dbTag := r.getDBTag(field)
		if dbTag != "" && dbTag != "-" {
			r.fields = append(r.fields, dbTag)
		}
	}
}

func (r *{{ .Name }}Repository) getDBTag(field reflect.StructField) string {
	dbTag := field.Tag.Get("db")
	if dbTag == "" {
		// Если тег db отсутствует, используем snake_case от имени поля
		return toSnakeCase(field.Name)
	}
	return dbTag
}

func toSnakeCase(str string) string {
	var result []rune
	for i, ch := range str {
		if i > 0 && ch >= 'A' && ch <= 'Z' {
			result = append(result, '_')
		}
		result = append(result, ch)
	}
	return strings.ToLower(string(result))
}

func (r *{{ .Name }}Repository) hasField(fieldName string) bool {
	modelType := reflect.TypeOf(models.{{ .Name }}{})
	for i := 0; i < modelType.NumField(); i++ {
		field := modelType.Field(i)
		if field.Name == fieldName {
			return true
		}
	}
	return false
}

func (r *{{ .Name }}Repository) getInsertFields(entity *models.{{ .Name }}) ([]string, []interface{}) {
	var fields []string
	var values []interface{}
	
	val := reflect.ValueOf(entity).Elem()
	typ := val.Type()

	// Добавляем временные метки только если они есть в модели
	now := time.Now()
	if r.hasField("CreatedAt") {
		fields = append(fields, "created_at")
		values = append(values, now)
	}
	if r.hasField("UpdatedAt") {
		fields = append(fields, "updated_at")
		values = append(values, now)
	}

	for i := 0; i < val.NumField(); i++ {
		field := typ.Field(i)
		fieldValue := val.Field(i)
		
		// Пропускаем ID и автоматически генерируемые поля (если они уже добавлены)
		if field.Name == "ID" {
			continue
		}
		if (field.Name == "CreatedAt" && r.hasField("CreatedAt")) || 
		   (field.Name == "UpdatedAt" && r.hasField("UpdatedAt")) {
			continue // Уже добавлены выше
		}
		
		dbTag := r.getDBTag(field)
		if dbTag == "" || dbTag == "-" {
			continue
		}
		
		// Включаем все поля, даже нулевые
		fields = append(fields, dbTag)
		values = append(values, fieldValue.Interface())
	}
	
	return fields, values
}

func (r *{{ .Name }}Repository) getReturningFields() string {
	returningFields := []string{"id"}
	
	if r.hasField("CreatedAt") {
		returningFields = append(returningFields, "created_at")
	}
	if r.hasField("UpdatedAt") {
		returningFields = append(returningFields, "updated_at")
	}
	
	return strings.Join(returningFields, ", ")
}

func (r *{{ .Name }}Repository) Create(ctx context.Context, entity *models.{{ .Name }}) error {
	fields, values := r.getInsertFields(entity)
	
	if len(fields) == 0 {
		return fmt.Errorf("no fields to insert")
	}
	
	// Создаем плейсхолдеры
	placeholders := make([]string, len(fields))
	for i := range fields {
		placeholders[i] = fmt.Sprintf("$%d", i+1)
	}
	
	returningFields := r.getReturningFields()
	query := fmt.Sprintf(
		"INSERT INTO %s (%s) VALUES (%s) RETURNING %s", 
		r.tableName, 
		strings.Join(fields, ", "), 
		strings.Join(placeholders, ", "),
		returningFields,
	)
	
	// Подготавливаем значения для RETURNING на основе доступных полей
	returningValues := []interface{}{&entity.ID}
	
	val := reflect.ValueOf(entity).Elem()
	if r.hasField("CreatedAt") {
		createdAtField := val.FieldByName("CreatedAt")
		if createdAtField.IsValid() {
			returningValues = append(returningValues, createdAtField.Addr().Interface())
		}
	}
	if r.hasField("UpdatedAt") {
		updatedAtField := val.FieldByName("UpdatedAt")
		if updatedAtField.IsValid() {
			returningValues = append(returningValues, updatedAtField.Addr().Interface())
		}
	}
	
	err := r.pool.QueryRow(ctx, query, values...).Scan(returningValues...)
	if err != nil {
		return fmt.Errorf("failed to create {{ .Name | lower }}: %w", err)
	}
	
	return nil
}

func (r *{{ .Name }}Repository) Update(ctx context.Context, id int, updates interface{}) error {
	var setClauses []string
	var values []interface{}

	// Добавляем updated_at только если он есть в модели
	if r.hasField("UpdatedAt") {
		setClauses = append(setClauses, "updated_at = $1")
		values = append(values, time.Now())
	}

	switch u := updates.(type) {
	case map[string]interface{}:
		if len(u) == 0 {
			return fmt.Errorf("no fields to update")
		}

		// Получаем допустимые поля из структуры модели
		allowedFields := make(map[string]bool)
		modelType := reflect.TypeOf(models.{{ .Name }}{})
		for i := 0; i < modelType.NumField(); i++ {
			field := modelType.Field(i)
			if field.Name != "ID" && field.Name != "CreatedAt" {
				dbTag := r.getDBTag(field)
				if dbTag != "" && dbTag != "-" {
					allowedFields[dbTag] = true
				}
			}
		}

		for field, value := range u {
			if allowedFields[field] {
				setClauses = append(setClauses, fmt.Sprintf("%s = $%d", field, len(values)+1))
				values = append(values, value)
			}
		}

	case *models.{{ .Name }}:
		val := reflect.ValueOf(u).Elem()
		typ := val.Type()

		for i := 0; i < val.NumField(); i++ {
			field := typ.Field(i)
			fieldValue := val.Field(i)

			// Пропускаем ID и автоматически генерируемые поля
			if field.Name == "ID" || field.Name == "CreatedAt" {
				continue
			}

			dbTag := r.getDBTag(field)
			if dbTag == "" || dbTag == "-" {
				continue
			}

			// Включаем все поля, даже нулевые
			setClauses = append(setClauses, fmt.Sprintf("%s = $%d", dbTag, len(values)+1))
			values = append(values, fieldValue.Interface())
		}

	default:
		return fmt.Errorf("unsupported update type: %T", updates)
	}

	if len(setClauses) == 0 {
		return fmt.Errorf("no valid fields to update")
	}

	values = append(values, id)
	query := fmt.Sprintf(
		"UPDATE %s SET %s WHERE id = $%d", 
		r.tableName, 
		strings.Join(setClauses, ", "), 
		len(values),
	)
	
	result, err := r.pool.Exec(ctx, query, values...)
	if err != nil {
		return fmt.Errorf("failed to update {{ .Name | lower }}: %w", err)
	}
	
	if result.RowsAffected() == 0 {
		return fmt.Errorf("{{ .Name | lower }} not found")
	}
	
	return nil
}

func (r *{{ .Name }}Repository) Delete(ctx context.Context, id int) error {
	query := fmt.Sprintf("DELETE FROM %s WHERE id = $1", r.tableName)
	result, err := r.pool.Exec(ctx, query, id)
	if err != nil {
		return fmt.Errorf("failed to delete {{ .Name | lower }}: %w", err)
	}
	
	if result.RowsAffected() == 0 {
		return fmt.Errorf("{{ .Name | lower }} not found")
	}
	
	return nil
}

func (r *{{ .Name }}Repository) Get(ctx context.Context, id int) (*models.{{ .Name }}, error) {
	query := fmt.Sprintf("SELECT %s FROM %s WHERE id = $1", 
		strings.Join(r.fields, ", "), 
		r.tableName)
	
	row := r.pool.QueryRow(ctx, query, id)
	
	item, err := r.scanRow(row)
	if err != nil {
		return nil, fmt.Errorf("{{ .Name | lower }} not found: %w", err)
	}
	
	return item, nil
}

func (r *{{ .Name }}Repository) List(ctx context.Context, limit, offset int) ([]models.{{ .Name }}, error) {
	// Используем created_at для сортировки, если он есть, иначе используем id
	orderBy := "id DESC"
	if r.hasField("CreatedAt") {
		orderBy = "created_at DESC"
	}
	
	query := fmt.Sprintf(
		"SELECT %s FROM %s ORDER BY %s LIMIT $1 OFFSET $2", 
		strings.Join(r.fields, ", "), 
		r.tableName,
		orderBy,
	)
	
	rows, err := r.pool.Query(ctx, query, limit, offset)
	if err != nil {
		return nil, fmt.Errorf("failed to list {{ .Name | lower }}s: %w", err)
	}
	defer rows.Close()

	var items []models.{{ .Name }}
	for rows.Next() {
		item, err := r.scanRows(rows)
		if err != nil {
			return nil, err
		}
		items = append(items, *item)
	}
	
	if err := rows.Err(); err != nil {
		return nil, fmt.Errorf("error iterating rows: %w", err)
	}
	
	return items, nil
}

func (r *{{ .Name }}Repository) Count(ctx context.Context) (int, error) {
	query := fmt.Sprintf("SELECT COUNT(*) FROM %s", r.tableName)
	var count int
	err := r.pool.QueryRow(ctx, query).Scan(&count)
	if err != nil {
		return 0, fmt.Errorf("failed to count {{ .Name | lower }}s: %w", err)
	}
	return count, nil
}


// Вспомогательные методы для сканирования

func (r *{{ .Name }}Repository) scanRow(row pgx.Row) (*models.{{ .Name }}, error) {
	var item models.{{ .Name }}
	
	scanValues := make([]interface{}, len(r.fields))
	val := reflect.ValueOf(&item).Elem()
	
	// Создаем маппинг полей для быстрого доступа
	fieldMap := make(map[string]reflect.Value)
	for i := 0; i < val.NumField(); i++ {
		field := val.Type().Field(i)
		dbTag := r.getDBTag(field)
		if dbTag != "" && dbTag != "-" {
			fieldMap[dbTag] = val.Field(i)
		}
	}
	
	// Сопоставляем поля для сканирования
	for i, fieldName := range r.fields {
		if field, exists := fieldMap[fieldName]; exists {
			scanValues[i] = field.Addr().Interface()
		} else {
			// Если поле не найдено, используем временную переменную
			var temp interface{}
			scanValues[i] = &temp
		}
	}
	
	err := row.Scan(scanValues...)
	if err != nil {
		return nil, err
	}
	
	return &item, nil
}

func (r *{{ .Name }}Repository) scanRows(rows pgx.Rows) (*models.{{ .Name }}, error) {
	var item models.{{ .Name }}
	
	scanValues := make([]interface{}, len(r.fields))
	val := reflect.ValueOf(&item).Elem()
	
	// Создаем маппинг полей для быстрого доступа
	fieldMap := make(map[string]reflect.Value)
	for i := 0; i < val.NumField(); i++ {
		field := val.Type().Field(i)
		dbTag := r.getDBTag(field)
		if dbTag != "" && dbTag != "-" {
			fieldMap[dbTag] = val.Field(i)
		}
	}
	
	// Сопоставляем поля для сканирования
	for i, fieldName := range r.fields {
		if field, exists := fieldMap[fieldName]; exists {
			scanValues[i] = field.Addr().Interface()
		} else {
			// Если поле не найдено, используем временную переменную
			var temp interface{}
			scanValues[i] = &temp
		}
	}
	
	err := rows.Scan(scanValues...)
	if err != nil {
		return nil, err
	}
	
	return &item, nil
}