func Test{{ .Name }}Repo_Count(t *testing.T) {
	db := SetupTestBBoltDB(t)
	repo := New{{ .Name }}Repo(db)
	
	err := repo.InitializeBucket()
	if err != nil {
		t.Fatalf("InitializeBucket failed: %v", err)
	}

	ctx := context.Background()

	// Начальный count должен быть 0
	count, err := repo.Count(ctx)
	if err != nil {
		t.Errorf("Count() error = %v", err)
		return
	}

	if count != 0 {
		t.Errorf("Initial Count() = %d, want 0", count)
	}

	// Создаем несколько entities и проверяем count
	expectedCount := 3
	for i := 0; i < expectedCount; i++ {
		entity := createTestEntity(&models.{{ .Name }}{}, i+1).(*models.{{ .Name }})
		err := repo.Create(ctx, entity)
		if err != nil {
			t.Fatalf("Setup: Create failed: %v", err)
		}
	}

	count, err = repo.Count(ctx)
	if err != nil {
		t.Errorf("Count() after creation error = %v", err)
		return
	}

	if count != expectedCount {
		t.Errorf("Count() after creation = %d, want %d", count, expectedCount)
	}
}

func Test{{ .Name }}Repo_InitializeBucket(t *testing.T) {
	db := SetupTestBBoltDB(t)
	repo := New{{ .Name }}Repo(db)

	// Первая инициализация должна пройти успешно
	err := repo.InitializeBucket()
	if err != nil {
		t.Errorf("InitializeBucket() first call error = %v", err)
	}

	// Повторная инициализация тоже должна работать
	err = repo.InitializeBucket()
	if err != nil {
		t.Errorf("InitializeBucket() second call error = %v", err)
	}

	// Проверяем, что bucket действительно создан и работает
	ctx := context.Background()
	testEntity := createTestEntity(&models.{{ .Name }}{}, 1).(*models.{{ .Name }})
	err = repo.Create(ctx, testEntity)
	if err != nil {
		t.Errorf("Create() after InitializeBucket failed: %v", err)
	}
}