func Test{{ .Name }}Repo_List(t *testing.T) {
	db := SetupTestBBoltDB(t)
	repo := New{{ .Name }}Repo(db)
	
	err := repo.InitializeBucket()
	if err != nil {
		t.Fatalf("InitializeBucket failed: %v", err)
	}

	ctx := context.Background()

	// Создаем несколько тестовых entities
	for i := 1; i <= 5; i++ {
		entity := createTestEntity(&models.{{ .Name }}{}, i).(*models.{{ .Name }})
		err := repo.Create(ctx, entity)
		if err != nil {
			t.Fatalf("Setup: Create failed: %v", err)
		}
	}

	tests := []struct {
		name         string
		limit        int
		offset       int
		wantCount    int
	}{
		{
			name:      "limit 2, offset 0",
			limit:     2,
			offset:    0,
			wantCount: 2,
		},
		{
			name:      "limit 3, offset 1",
			limit:     3,
			offset:    1,
			wantCount: 3,
		},
		{
			name:      "limit 10, offset 0 (more than exists)",
			limit:     10,
			offset:    0,
			wantCount: 5,
		},
		{
			name:      "limit 2, offset 4 (out of range)",
			limit:     2,
			offset:    4,
			wantCount: 1,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			items, err := repo.List(ctx, tt.limit, tt.offset)
			if err != nil {
				t.Errorf("List() error = %v", err)
				return
			}

			if len(items) != tt.wantCount {
				t.Errorf("List() returned %d items, want %d", len(items), tt.wantCount)
			}
		})
	}
}

