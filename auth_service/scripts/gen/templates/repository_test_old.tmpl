func Test{{ .Name }}Repository_List(t *testing.T) {
	pool := setupTestDB(t)
	repo := New{{ .Name }}Repository(pool)

	ctx := context.Background()

	// Создаем несколько тестовых entities
	entities := make([]*models.{{ .Name }}, 5)
	for i := 0; i < 5; i++ {
		entity := testutils.CreateTestEntity(&models.{{ .Name }}{}, i+1).(*models.{{ .Name }})
		err := repo.Create(ctx, entity)
		require.NoError(t, err, "Setup: Create failed")
		entities[i] = entity
	}

	tests := []struct {
		name      string
		limit     int
		offset    int
		wantCount int
		wantErr   bool
	}{
		{
			name:      "limit 2, offset 0",
			limit:     2,
			offset:    0,
			wantCount: 2,
			wantErr:   false,
		},
		{
			name:      "limit 3, offset 1",
			limit:     3,
			offset:    1,
			wantCount: 3,
			wantErr:   false,
		},
		{
			name:      "limit 10, offset 0 (more than exists)",
			limit:     10,
			offset:    0,
			wantCount: 5,
			wantErr:   false,
		},
		{
			name:      "limit 2, offset 5 (out of range)",
			limit:     2,
			offset:    5,
			wantCount: 0,
			wantErr:   false,
		},
		{
			name:      "negative limit",
			limit:     -1,
			offset:    0,
			wantCount: 0,
			wantErr:   false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			items, err := repo.List(ctx, tt.limit, tt.offset)

			if tt.wantErr {
				assert.Error(t, err)
			} else {
				assert.NoError(t, err)
				assert.Len(t, items, tt.wantCount)

				// Проверяем порядок (должен быть по created_at DESC)
				for i := 1; i < len(items); i++ {
					assert.True(t, items[i-1].CreatedAt.After(items[i].CreatedAt) || 
						items[i-1].CreatedAt.Equal(items[i].CreatedAt))
				}
			}
		})
	}
}

