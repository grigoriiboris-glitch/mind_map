func createTest{{ .Name }}(id int) *models.{{ .Name }} {
	return testutils.CreateTestEntity(&models.{{ .Name }}{}, id).(*models.{{ .Name }})
}

func populateTestData(t *testing.T, repo *{{ .Name }}Repository, count int) []*models.{{ .Name }} {
	t.Helper()
	
	ctx := context.Background()
	var entities []*models.{{ .Name }}

	for i := 1; i <= count; i++ {
		entity := createTest{{ .Name }}(i)
		err := repo.Create(ctx, entity)
		require.NoError(t, err, "Failed to create test entity")
		entities = append(entities, entity)
	}

	return entities
}