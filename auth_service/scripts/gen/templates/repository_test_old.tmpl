func Test{{ .Name }}Repository_FindByUserID(t *testing.T) {
	pool := setupTestDB(t)
	repo := New{{ .Name }}Repository(pool)

	ctx := context.Background()

	// Создаем entities для разных пользователей
	user1Entities := 3
	user2Entities := 2

	for i := 0; i < user1Entities; i++ {
		entity := testutils.CreateTestEntity(&models.{{ .Name }}{}, i+1).(*models.{{ .Name }})
		entity.UserId = 1 // Исправлено: UserId вместо UserID
		err := repo.Create(ctx, entity)
		require.NoError(t, err, "Setup: Create failed for user 1")
	}

	for i := 0; i < user2Entities; i++ {
		entity := testutils.CreateTestEntity(&models.{{ .Name }}{}, i+user1Entities+1).(*models.{{ .Name }})
		entity.UserId = 2 // Исправлено: UserId вместо UserID
		err := repo.Create(ctx, entity)
		require.NoError(t, err, "Setup: Create failed for user 2")
	}

	tests := []struct {
		name      string
		userID    int
		limit     int
		offset    int
		wantCount int
		wantErr   bool
	}{
		{
			name:      "user 1 with limit 10",
			userID:    1,
			limit:     10,
			offset:    0,
			wantCount: user1Entities,
			wantErr:   false,
		},
		{
			name:      "user 2 with limit 10",
			userID:    2,
			limit:     10,
			offset:    0,
			wantCount: user2Entities,
			wantErr:   false,
		},
		{
			name:      "non-existing user",
			userID:    999,
			limit:     10,
			offset:    0,
			wantCount: 0,
			wantErr:   false,
		},
		{
			name:      "user 1 with pagination",
			userID:    1,
			limit:     2,
			offset:    1,
			wantCount: 2,
			wantErr:   false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			items, err := repo.FindByUserID(ctx, tt.userID, tt.limit, tt.offset)

			if tt.wantErr {
				assert.Error(t, err)
			} else {
				assert.NoError(t, err)
				assert.Len(t, items, tt.wantCount)

				// Проверяем, что все entities принадлежат указанному пользователю
				for _, item := range items {
					assert.Equal(t, tt.userID, item.UserId) // Исправлено: UserId вместо UserID
				}

				// Проверяем порядок (должен быть по created_at DESC)
				for i := 1; i < len(items); i++ {
					assert.True(t, items[i-1].CreatedAt.After(items[i].CreatedAt) || 
						items[i-1].CreatedAt.Equal(items[i].CreatedAt))
				}
			}
		})
	}
}

func Test{{ .Name }}Repository_ConcurrentOperations(t *testing.T) {
	pool := setupTestDB(t)
	repo := New{{ .Name }}Repository(pool)

	ctx := context.Background()

	// Тест на конкурентные операции
	t.Run("concurrent creates", func(t *testing.T) {
		const goroutines = 5
		const entitiesPerGoroutine = 10

		errChan := make(chan error, goroutines)

		for i := 0; i < goroutines; i++ {
			go func(id int) {
				for j := 0; j < entitiesPerGoroutine; j++ {
					entity := testutils.CreateTestEntity(&models.{{ .Name }}{}, id*entitiesPerGoroutine+j+1).(*models.{{ .Name }})
					if err := repo.Create(ctx, entity); err != nil {
						errChan <- err
						return
					}
				}
				errChan <- nil
			}(i)
		}

		// Ждем завершения всех горутин
		for i := 0; i < goroutines; i++ {
			assert.NoError(t, <-errChan)
		}

		// Проверяем, что все entities созданы
		count, err := repo.Count(ctx)
		assert.NoError(t, err)
		assert.Equal(t, goroutines*entitiesPerGoroutine, count)
	})
}

