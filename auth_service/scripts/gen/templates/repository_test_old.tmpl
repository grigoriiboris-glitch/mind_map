func setupTestDB(t *testing.T) *pgxpool.Pool {
	t.Helper()
	
	// Здесь должна быть логика подключения к тестовой БД
	// Например, использование testcontainers или временной БД
	pool, err := pgxpool.New(context.Background(), "postgresql://postgres:password@postgres:5432/test")
	require.NoError(t, err, "Failed to connect to test database")

	t.Cleanup(func() {
		pool.Close()
	})

	// Очистка таблицы перед тестом
	_, err = pool.Exec(context.Background(), "TRUNCATE TABLE {{ .Name | lower }}s RESTART IDENTITY CASCADE")
	require.NoError(t, err, "Failed to truncate table")

	return pool
}

func Test{{ .Name }}Repository_Create(t *testing.T) {
	pool := setupTestDB(t)
	repo := New{{ .Name }}Repository(pool)

	ctx := context.Background()

	tests := []struct {
		name        string
		entity      *models.{{ .Name }}
		wantErr     bool
		errContains string
	}{
		{
			name:    "successful creation",
			entity:  testutils.CreateTestEntity(&models.{{ .Name }}{}, 1).(*models.{{ .Name }}),
			wantErr: false,
		},
		{
			name: "creation with required fields only",
			entity: &models.{{ .Name }}{
				// Заполнить обязательные поля - используйте правильные имена полей из вашей модели
				Title:  "Required Title",
				UserId: 1, // Исправлено: UserId вместо UserID
			},
			wantErr: false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			err := repo.Create(ctx, tt.entity)

			if tt.wantErr {
				assert.Error(t, err)
				if tt.errContains != "" {
					assert.Contains(t, err.Error(), tt.errContains)
				}
			} else {
				assert.NoError(t, err)
				assert.NotZero(t, tt.entity.ID, "ID should be set after creation")
				assert.False(t, tt.entity.CreatedAt.IsZero(), "CreatedAt should be set")
				assert.False(t, tt.entity.UpdatedAt.IsZero(), "UpdatedAt should be set")
			}
		})
	}
}

func Test{{ .Name }}Repository_Get(t *testing.T) {
	pool := setupTestDB(t)
	repo := New{{ .Name }}Repository(pool)

	ctx := context.Background()

	// Создаем тестовые данные
	testEntity := testutils.CreateTestEntity(&models.{{ .Name }}{}, 1).(*models.{{ .Name }})
	err := repo.Create(ctx, testEntity)
	require.NoError(t, err, "Setup: Create failed")

	tests := []struct {
		name        string
		id          int
		wantErr     bool
		errContains string
	}{
		{
			name:    "existing entity",
			id:      testEntity.ID,
			wantErr: false,
		},
		{
			name:        "non-existing entity",
			id:          999,
			wantErr:     true,
			errContains: "not found",
		},
		{
			name:        "invalid ID",
			id:          0,
			wantErr:     true,
			errContains: "not found",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			entity, err := repo.Get(ctx, tt.id)

			if tt.wantErr {
				assert.Error(t, err)
				if tt.errContains != "" {
					assert.Contains(t, err.Error(), tt.errContains)
				}
				assert.Nil(t, entity)
			} else {
				assert.NoError(t, err)
				assert.NotNil(t, entity)
				assert.Equal(t, tt.id, entity.ID)
				// Проверяем, что все поля корректно загружены
				assert.Equal(t, testEntity.Title, entity.Title)
				assert.Equal(t, testEntity.UserId, entity.UserId) // Исправлено: UserId вместо UserID
			}
		})
	}
}

func Test{{ .Name }}Repository_Update(t *testing.T) {
	pool := setupTestDB(t)
	repo := New{{ .Name }}Repository(pool)

	ctx := context.Background()

	// Создаем оригинальную сущность
	originalEntity := testutils.CreateTestEntity(&models.{{ .Name }}{}, 1).(*models.{{ .Name }})
	err := repo.Create(ctx, originalEntity)
	require.NoError(t, err, "Setup: Create failed")

	tests := []struct {
		name        string
		id          int
		updates     interface{}
		wantErr     bool
		errContains string
	}{
		{
			name: "successful update with map",
			id:   originalEntity.ID,
			updates: map[string]interface{}{
				"title":   "Updated Title",
				"content": "Updated content",
			},
			wantErr: false,
		},
		{
			name: "successful update with partial struct",
			id:   originalEntity.ID,
			updates: &models.{{ .Name }}{
				Title: "Updated Title Struct",
			},
			wantErr: false,
		},
		{
			name:        "update non-existing entity",
			id:          999,
			updates:     map[string]interface{}{"title": "Updated"},
			wantErr:     true,
			errContains: "no rows",
		},
		{
			name:        "update with invalid field",
			id:          originalEntity.ID,
			updates:     map[string]interface{}{"invalid_field": "value"},
			wantErr:     false, // Invalid fields игнорируются
		},
		{
			name:        "update with empty data",
			id:          originalEntity.ID,
			updates:     map[string]interface{}{},
			wantErr:     true,
			errContains: "no fields to update",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			err := repo.Update(ctx, tt.id, tt.updates)

			if tt.wantErr {
				assert.Error(t, err)
				if tt.errContains != "" {
					assert.Contains(t, err.Error(), tt.errContains)
				}
			} else {
				assert.NoError(t, err)

				// Проверяем, что обновление применилось
				updated, err := repo.Get(ctx, tt.id)
				assert.NoError(t, err)

				// Проверяем, что системные поля не изменились
				assert.Equal(t, originalEntity.ID, updated.ID)
				assert.Equal(t, originalEntity.CreatedAt.UTC(), updated.CreatedAt.UTC())

				// Проверяем обновленные поля
				switch u := tt.updates.(type) {
				case map[string]interface{}:
					for field, value := range u {
						switch field {
						case "title":
							assert.Equal(t, value, updated.Title)
						case "content":
							assert.Equal(t, value, updated.Content)
						}
					}
				case *models.{{ .Name }}:
					if u.Title != "" {
						assert.Equal(t, u.Title, updated.Title)
					}
				}
			}
		})
	}
}

