api/ корневая
ниже все файлы в папке апи

cmd/
  server/
    main.go                # точка входа

internal/
  exception/
  auth/                    # всё про аутентификацию и авторизацию
    auth_service.go
    middleware.go
    rate_limiter.go
    config.go
    ...
  config/                  # загрузка конфигурации (env, yaml)
    config.go
  db/                      # подключение к БД
    db.go
  http/					   # HTTP
    requests/ #входящие данные и их валидация
		auth/
		mindmap/
		post/
		user/
    middleware/
	routes/ # здесь определение маршрутов и указание хэндлеров для обработки
    handlers/                # только HTTP-слой (JSON)
      auth_handler.go
      mindmaps_handler.go
      posts_handler.go
      user_handler.go
  services/                # бизнес-логика, тонкий слой между repo и handlers
    auth_service.go
    mindmaps_service.go
    posts_service.go
    user_service.go
  server/                  # настройка mux, middlewares
    server.go

models/                    # доменные сущности (структуры)
  mindmap.go
  post.go
  user.go

repository/                # доступ к БД
  migrations/
	000001_create_posts_table.up.sql
    ...
  mindmap_repository.go
  post_repository.go
  user_repository.go

storage/
    uploads
	cache/
	logs/

pkg/                       # (опционально) общие утилиты, которые могут жить вне internal
  logger/
  utils/

scripts/                   # вспомогательные скрипты (миграции, сидинг)
  migrate.sh

docs/                     

tests/                     # интеграционные / e2e тесты
  auth_integration_test.go
  posts_integration_test.go

переделать структуру по указанной схеме, вынести бизнес логику из хэндлеров

🔑 Основные идеи

cmd/server/main.go — только точка входа. Никакой логики.

internal/services/ — твой бизнес-уровень. Например:

MindMapService — отвечает за бизнес-логику карт,

PostService — за посты.
Таким образом, handlers будут тонкими: JSON → вызов сервиса → JSON.

internal/handlers/ — только HTTP-контроллеры (CRUD API).

repository/ — вся работа с БД (sqlx/pgx). Методы стандартизировать (FindByID, FindAll, Create, Update, Delete).

pkg/ — общие утилиты (например, кастомный логгер), которые можно использовать в других проектах.

docs/ — спецификация API (Swagger/OpenAPI).

tests/ — для интеграционных тестов (с httptest.Server или testcontainers-go).

!!!!!!!!!!!!!!!!!!!
Логирование: zap или logrus
Очереди: machinery или asynq
CLI: spf13/cobra
Кэширование: go-redis/redis

